# Microsoft 365 sign-in is handled by the BACKEND (see backend/.env). The frontend needs no Entra settings.

# API base URL. Keep "/api" in development: Vite forwards /api and /auth/callback to the backend.
VITE_API_BASE_URL=/api
# Backend address used by the Vite dev proxy
VITE_BACKEND_URL=http://localhost:4000

# Development only: sign in as a mock user WITHOUT the backend (Student | Organizer | Admin | ITAdmin).
# Put this in .env.local. Remove it to use real Microsoft 365 sign-in. Ignored in production builds.
# VITE_DEV_MOCK_ROLE=Student
