NODE_ENV=development
PORT=4000
# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:5173
# Where users land after signing in / out (defaults to the first CORS_ORIGIN)
FRONTEND_URL=http://localhost:5173

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=mcu_digital_passport
DB_CONNECTION_LIMIT=10

# Microsoft Entra ID: the backend signs users in (app registration, "Web" platform)
ENTRA_TENANT_ID=your-tenant-id
ENTRA_CLIENT_ID=your-app-client-id
# Certificates & secrets -> the secret's VALUE (shown once when created), NOT the "Secret ID"
ENTRA_SECRET_ID=your-client-secret-value
# Must exactly match a Web redirect URI in the app registration.
# In development the Vite dev server forwards /auth/callback to this backend.
ENTRA_REDIRECT_URI=http://localhost:5173/auth/callback
# Only if students and staff are in SEPARATE Microsoft 365 tenants: list both tenant ids (comma-separated).
# Leave unset when both domains are in the same tenant (defaults to ENTRA_TENANT_ID).
# ENTRA_ALLOWED_TENANT_IDS=staff-tenant-id,student-tenant-id

# MCU account domains
ALLOWED_EMAIL_DOMAINS=student.mcu.edu.ph,mcu.edu.ph
# Accounts from this domain are Students automatically; staff need an app role (Organizer/Admin/ITAdmin)
STUDENT_EMAIL_DOMAIN=student.mcu.edu.ph

# App session (JWT in an httpOnly cookie, issued after Microsoft sign-in)
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('base64url'))"
SESSION_JWT_SECRET=8bRgQmM269sYoWEWXauaGnS2k01fzjx3S6zFBL3R9QN
SESSION_TTL_HOURS=8
