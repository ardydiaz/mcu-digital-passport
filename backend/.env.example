NODE_ENV=development
PORT=4000
# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:5173

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=mcu_digital_passport
DB_CONNECTION_LIMIT=10

# Microsoft Entra ID
ENTRA_TENANT_ID=your-tenant-id
ENTRA_CLIENT_ID=your-api-app-client-id
# Usually api://<api-client-id> (or the client id itself, depending on token version)
ENTRA_API_AUDIENCE=api://your-api-app-client-id
